# Use when .output is already built on the host (avoids OOM during docker build).
# Build the website first: cd website && bun install --frozen-lockfile && bun run build
FROM oven/bun:alpine

WORKDIR /app

COPY package.json bun.lock ./

RUN bun install --frozen-lockfile

COPY . .

RUN bun run build

ENV PORT=8080

EXPOSE 8080

CMD ["bun", "run", ".output/server/index.mjs"]
