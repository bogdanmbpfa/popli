FROM node:24-alpine

WORKDIR /app

ENV PNPM_HOME=/usr/local/bin
RUN corepack enable && corepack prepare pnpm@latest --activate

RUN pnpm add -g typescript

COPY package.json ./

RUN pnpm install

RUN pnpm install sharp --force

COPY . .

RUN pnpm run build

EXPOSE 8080

RUN chmod +x ./docker/start-gcp.sh
ENTRYPOINT ["sh", "./docker/start-gcp.sh"]
